{
  "expo": {
    "name": "spell-to-excel",
    "slug": "spell-to-excel",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./src/assets/1.jpeg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/1.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "orientation": "landscape",
      "supportsTablet": true,
      "infoPlist": {
        "UIRequiresFullScreen": true
    }
  },
    "android": {
      "adaptiveIcon": {
        "orientation": "landscape",
        "foregroundImage": "./src/assets/1.jpeg",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./src/assets/1.jpeg"
    }
  }
}
